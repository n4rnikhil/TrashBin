# Copy to backend/.env (git-ignored) and fill in. Never commit real values.
# Full reference: docs/SYSTEM_ARCHITECTURE.md "Configuration reference".

# Active profile: dev | test | prod
SPRING_PROFILES_ACTIVE=dev

# Application database (trashbin_db)
TRASHBIN_DB_URL=jdbc:postgresql://localhost:5432/trashbin_db
TRASHBIN_DB_USERNAME=trashbin
TRASHBIN_DB_PASSWORD=<set-your-own-password>

# Test database (trashbin_test_db), used by the "test" profile
TRASHBIN_TEST_DB_URL=jdbc:postgresql://localhost:5432/trashbin_test_db
TRASHBIN_TEST_DB_USERNAME=trashbin
TRASHBIN_TEST_DB_PASSWORD=<set-your-own-password>

# Blob storage root: absolute path OUTSIDE this repository (must not be inside any git working tree)
TRASHBIN_STORAGE_ROOT=C:/Users/<you>/TrashBinData

# Optional (defaults shown)
# TRASHBIN_MAX_FILE_SIZE_MB=250
