# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# --- Backend ---------------------------------------------------------------
[*.java]
indent_size = 4
max_line_length = 100
continuation_indent_size = 8

[{pom.xml,*.xml}]
indent_size = 4

[*.{properties,yml,yaml}]
indent_size = 2

[*.sql]
indent_size = 2
max_line_length = 100

# --- Frontend --------------------------------------------------------------
[*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,html}]
indent_size = 2
max_line_length = 100

# --- Docs ------------------------------------------------------------------
[*.md]
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

# --- Windows scripts keep CRLF ---------------------------------------------
[*.{cmd,bat}]
end_of_line = crlf

# --- Generated or vendored: do not reformat --------------------------------
[backend/openapi/openapi.json]
insert_final_newline = true
indent_size = 2

[package-lock.json]
indent_size = 2
